# Optional: copy to frontend/.env.local. No secrets may be placed in VITE_* values.
# Leave empty to use same-origin /api via the Vite development proxy.
VITE_API_BASE_URL=
# Vite server-side proxy destination; change when the backend listener port changes.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
