# Copy to .env; never commit real keys. OS environment overrides this file.
# Both application and Podman use the same Settings/python-dotenv parser.
# Use literal values; this file is never executed as shell code.

# 1. Model service: supply your own key for full AI conversations.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
# Official DeepSeek configuration reuses LLM_API_KEY when this is empty.
# Other providers/proxies need a separate search key for external knowledge search.
DEEPSEEK_SEARCH_API_KEY=

# 2. Authentication: generate with openssl rand -hex 32.
AUTH_TOKEN_SECRET=replace-with-a-local-random-secret
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=14
APP_ENV=local

# 3. Local PostgreSQL. Keep pc-agent to reuse existing volumes.
# For a separate installation change the prefix, ports and connection destination.
PODMAN_PROJECT_NAME=pc-agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pc_agent
POSTGRES_USER=pc_agent
POSTGRES_PASSWORD=pc_agent
# Optional complete override for an existing/external database. Empty derives from above.
# Explicit URLs need URL-encoded usernames/passwords; derived URLs encode automatically.
DATABASE_URL=

# 4. Application listeners. make backend/frontend read these same values.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Empty derives localhost and 127.0.0.1 origins from FRONTEND_PORT.
BACKEND_CORS_ORIGINS=
# Optional external frontend API/proxy overrides remain in frontend/.env.local.

# 5. Optional local Phoenix: fixed loopback endpoint http://127.0.0.1:6006.
# make trace-up starts the independent platform; restart backend after changing this.
LOOP_TRACE_ENABLED=false

# 6. Optional legacy infrastructure; unnecessary for current policy_search.
REDIS_ENABLED=false
REDIS_PORT=6379
REDIS_URL=
CHROMA_ENABLED=false
CHROMA_HOST=localhost
CHROMA_PORT=8001
KNOWLEDGE_COLLECTION=pc_agent_knowledge
KNOWLEDGE_SCORE_THRESHOLD=0.16

# 7. Container image overrides (normally leave unchanged).
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
CHROMA_IMAGE=docker.io/chromadb/chroma@sha256:bd21353aee6ccdf4a57bd91e6001626826700f3838e1f230d4aae75bfd4889a1
# Advanced resource overrides: PODMAN_NETWORK, POSTGRES_CONTAINER/POSTGRES_VOLUME,
# REDIS_CONTAINER/REDIS_VOLUME, CHROMA_CONTAINER/CHROMA_VOLUME.

# 8. Development compatibility. Main release will expose the agent loop only.
AGENT_RUNTIME=strands
AGENT_CONTEXT_BUDGET_TOKENS=6000
CATALOG_LLM_PLANNER_ENABLED=true
# Legacy trace only; independent of LOOP_TRACE_ENABLED/Phoenix.
AGENT_TRACE_MODE=off
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pc-ecommerce-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
