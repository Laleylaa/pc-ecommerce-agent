# Copy to .env. Existing .env files are never overwritten by setup.
# Non-empty shell environment values override this file for Podman settings.
# Use literal KEY=value lines (optionally quoted); do not use shell expressions.

# Podman: retain pc-agent to reuse the existing local containers and data.
# For isolation, change the project name AND ports, then update connection URLs.
PODMAN_PROJECT_NAME=pc-agent
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# Immutable digest recorded from the existing Chroma image (no floating latest).
CHROMA_IMAGE=docker.io/chromadb/chroma@sha256:bd21353aee6ccdf4a57bd91e6001626826700f3838e1f230d4aae75bfd4889a1
POSTGRES_PORT=5432
REDIS_PORT=6379
CHROMA_PORT=8001
POSTGRES_DB=pc_agent
POSTGRES_USER=pc_agent
POSTGRES_PASSWORD=pc_agent

# Backend connections: keep these consistent with the container ports/credentials.
# URL-encode special characters in database usernames and passwords.
DATABASE_URL=postgresql+asyncpg://pc_agent:pc_agent@localhost:5432/pc_agent
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
KNOWLEDGE_COLLECTION=pc_agent_knowledge
KNOWLEDGE_SCORE_THRESHOLD=0.16

# LLM_API_KEY is required for full AI behavior; never commit a real key.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=
CATALOG_LLM_PLANNER_ENABLED=true
AGENT_CONTEXT_BUDGET_TOKENS=6000

# Peripheral web search: https://app.tavily.com (free monthly credits, no card required).
# Server-side only. Empty key disables knowledge_search; local policy_search still works.
TAVILY_API_KEY=

# Trace is opt-in: off / local / langsmith. Local files are always retained when enabled.
# Default output: backend/evals/results/agent_traces/ (independent of current directory).
AGENT_TRACE_MODE=off
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pc-ecommerce-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Generate your own random AUTH_TOKEN_SECRET; see README.
APP_ENV=local
AUTH_TOKEN_SECRET=replace-with-a-local-random-secret
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=14
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend overrides belong in frontend/.env.local, not this file.
# Backend listener overrides: make backend BACKEND_PORT=8002 (see README).
