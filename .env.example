# Copy to .env and fill in credentials. Never commit real keys.
# Application and Podman read this file; process environment overrides it.
# Values are dotenv literals, not executable shell expressions.

# Model service. Default: official DeepSeek.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
# Optional for official DeepSeek (reuses LLM_API_KEY); required for search with another provider.
DEEPSEEK_SEARCH_API_KEY=

# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace-with-a-local-random-secret
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=14
APP_ENV=local

# PostgreSQL. A new prefix/port isolates a separate local installation.
PODMAN_PROJECT_NAME=pc-agent
POSTGRES_HOST=localhost
# Host-side port binding; independent of the database connection hostname above.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pc_agent
POSTGRES_USER=pc_agent
POSTGRES_PASSWORD=pc_agent
# Empty derives from the fields above. An explicit URL takes precedence.
DATABASE_URL=
POSTGRES_IMAGE=postgres:16-alpine

# Application listeners. Start with make backend / make frontend.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Empty derives localhost/127.0.0.1 origins from FRONTEND_PORT.
BACKEND_CORS_ORIGINS=
AGENT_CONTEXT_BUDGET_TOKENS=6000

# Optional resource overrides: PODMAN_NETWORK, POSTGRES_CONTAINER, POSTGRES_VOLUME.
# Frontend proxy overrides belong in frontend/.env.local; never put secrets in VITE_*.
