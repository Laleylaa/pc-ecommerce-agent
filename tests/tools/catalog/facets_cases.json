      "id": "facets-smoke",
      "kind": "smoke",
      "input": {
        "query": "店里有哪些商品品类？请完整列出。",
        "limit": 50
      },
      "oracle_scenario": "facets_categories",
      "intent": "全店品类目录，无category_hint也无需先选品类。",
      "hard": [
        [
          "output.facet",
          "eq",
          "category"
        ],
        [
          "output.result_type",
          "eq",
          "facets"
        ],
        [
          "output.returned_count",
          "eq",
          "$oracle.total"
        ],
        [
          "output.total_value_count",
          "eq",
          "$oracle.total"
        ],
        [
          "output.is_exhaustive",
          "eq",
          true
        ],
        [
          "output.matching_complete",
          "eq",
          true
        ],
        [
          "output.facet_counts",
          "eq",
          "$oracle.facet_counts"
        ],
        [
          "output.facet_sources",
          "eq",
          "$oracle.facet_sources"
        ],
        [
          "output.unique_facet_values",
          "eq",
          true
        ]
      ],
      "trace_route": "model",
      "semantic_expectation": "全店品类目录，无category_hint也无需先选品类。",
      "allowed_equivalences": [
        "不比较解释文字逐字一致；必须完整保留需求。",
