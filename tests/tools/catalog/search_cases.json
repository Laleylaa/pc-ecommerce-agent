  "common_semantic": [
    {
      "id": "intent",
      "criterion": "是否完整理解本例需求；功能事实不能改成筛选，目录不能变成单商品资料。"
    },
    {
      "id": "scope",
      "criterion": "身份、品类、可信scope及同SKU范围是否忠实；不得猜编号或缩小全店目录。"
    },
    {
      "id": "workflow",
      "criterion": "逐阶段检查范围计划、业务计划、复核和程序校验；有修正则检查全部尝试。approve不等于通过。"
    },
    {
      "id": "facts",
      "criterion": "逐项对照独立原始行、冻结预期、最终返回与Trace，不跨版本拼规格，不遗漏必要事实。"
    }
  ],
  "cases": [
    {
      "id": "search-smoke",
      "kind": "smoke",
      "input": {
        "query": "300元以内的键盘，按价格从低到高推荐2款。",
        "limit": 2
      },
      "oracle_scenario": "search_price",
      "intent": "不提供category_hint；识别键盘与预算上限（含300），返回最便宜两个型号。",
      "hard": [
        [
          "output.query_plan.operation",
          "eq",
          "search"
        ],
        [
          "output.match_kind",
          "eq",
          "exact"
        ],
        [
          "output.fallback_attempted",
          "eq",
          false
        ],
        [
          "output.returned_count",
          "eq",
          "$oracle.returned"
        ],
        [
          "output.total_match_count",
          "eq",
          "$oracle.total"
        ],
        [
          "output.matched_sku_count",
          "eq",
          "$oracle.sku_count"
        ],
        [
          "output.product_spu_ids",
          "set_eq",
          "$oracle.spu_ids"
        ],
        [
          "output.product_sku_ids",
          "nonempty_subset",
          "$oracle.selected_sku_ids"
        ],
        [
          "output.product_prices",
          "decimal_list_eq",
          "$oracle.selected_prices"
        ]
      ],
      "trace_route": "model",
      "semantic_expectation": "不提供category_hint；识别键盘与预算上限（含300），返回最便宜两个型号。",
