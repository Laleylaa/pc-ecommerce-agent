  "trace_requirements": {
    "models": "至少一次真实 tool_planning 和一次 tool_review；允许既有预算内修正，保留所有尝试，不强制恰好两次",
    "checks": [
      "计划校验",
      "复核输出校验",
      "工具输出校验"
    ],
    "events": [
      "程序 · 商品查询上下文",
      "程序 · 执行计划确认",
      "程序 · 对象定位",
      "程序 · 条件筛选",
      "程序 · 排序与返回窗口",
      "程序 · 商品查询返回"
    ],
    "required": "根/工具/模型/校验关联同一 trace；用例、批次和尝试关联正确；工具输入输出和输出校验前结果可读且一致；无关键截断。缺证据为无法判定，已有明确业务失败仍判失败。"
  },
  "common_semantic": [
    {
      "id": "intent",
      "criterion": "用户只问已指定对象的价格。必须 lookup，仅 requested_fields=price；不能改为找候选、列版本或追加规格询问。",
      "evidence": [
        "用户输入",
        "实际模型规划输出",
        "最终 query_plan",
        "facts"
      ]
    },
    {
      "id": "identity",
      "criterion": "保留本条指定的品牌、型号或 SKU；不得误取其他品牌同名 K01，不能用型号数字猜数据库编号。具体可接受形式见本条标注。",
      "evidence": [
        "规划与执行计划事件",
        "对象定位事件",
        "独立数据库依据",
        "facts.target"
      ]
    },
    {
      "id": "constraints",
      "criterion": "本批没有预算、库存、颜色或软偏好。除原文品牌的等价硬限定外不能新增筛选；不把价格询问变为价格条件。",
      "evidence": [
        "初始及修正计划",
        "conditions",
        "条件筛选事件"
      ]
    },
    {
      "id": "population",
      "criterion": "型号报价覆盖该型号全部在售版本；SKU 报价只覆盖明确 SKU。不得跨型号聚合，不得用展示数量限制报价；层级和完整性须符合逐例标注。",
      "evidence": [
        "独立 SQL 行与价格",
        "对象定位/聚合窗口事件",
        "输出校验前结果",
        "最终 facts"
      ]
    },
    {
      "id": "review",
      "criterion": "逐次阅读真实规划、复核及修正内容，判断最终计划是否忠实；模型 approve 和程序 accepted 仅作过程证据。任何未修正的遗漏/增设/换对象均失败；无法读取必要过程则无法判定。",
      "evidence": [
        "所有 LLM 输入输出",
        "三类程序校验",
        "修正重试事件"
      ]
    }
  ],
